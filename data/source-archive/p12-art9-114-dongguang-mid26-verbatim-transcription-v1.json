{
  "source_paper_id": "SCI_G04_S1_114_MID_008",
  "tf": [
    {
      "id": "SCI_G04_S1_114_MID_008|S01|TF|001",
      "text": "比較岩石、沙和土壤的顆粒大小，其中岩石的顆粒最大，沙的顆粒最小。",
      "source_pdf_page": 1,
      "marker_y": 151.25
    },
    {
      "id": "SCI_G04_S1_114_MID_008|S01|TF|002",
      "text": "適合生活在生態池裡的生物，不一定適合生活在溪流中。",
      "source_pdf_page": 1,
      "marker_y": 196.73
    },
    {
      "id": "SCI_G04_S1_114_MID_008|S01|TF|003",
      "text": "進行水域調查活動時，可以將在溪流採集的水生生物放到其他的水域環境。",
      "source_pdf_page": 1,
      "marker_y": 242.09
    },
    {
      "id": "SCI_G04_S1_114_MID_008|S01|TF|004",
      "text": "水生植物為了適應水中生活，大部分都有特殊的構造，例如水蘊草具有柔軟的莖和葉，以適應水位變化和減少水流的衝擊。",
      "source_pdf_page": 1,
      "marker_y": 287.6
    },
    {
      "id": "SCI_G04_S1_114_MID_008|S01|TF|005",
      "text": "漂浮性水生植物的根漂浮在水裡，葉漂浮在水面上。",
      "source_pdf_page": 1,
      "marker_y": 369.44
    },
    {
      "id": "SCI_G04_S1_114_MID_008|S01|TF|006",
      "text": "水生動物都是魚、蝦、蟹類，不可能在水中發現昆蟲。",
      "source_pdf_page": 1,
      "marker_y": 414.8
    },
    {
      "id": "SCI_G04_S1_114_MID_008|S01|TF|007",
      "text": "蝌蚪與蛙，牠們的外形及運動方式都不盡相同。",
      "source_pdf_page": 1,
      "marker_y": 460.28
    },
    {
      "id": "SCI_G04_S1_114_MID_008|S01|TF|008",
      "text": "清理學校的生態池會干擾生長在其中的生物，所以不要定期實施。",
      "source_pdf_page": 1,
      "marker_y": 505.66
    },
    {
      "id": "SCI_G04_S1_114_MID_008|S01|TF|009",
      "text": "在水域環境附近亂丟垃圾或任意排放廢水，都可能造成水域環境汙染或破壞",
      "source_pdf_page": 1,
      "marker_y": 551.14
    },
    {
      "id": "SCI_G04_S1_114_MID_008|S01|TF|010",
      "text": "任何植物都無法在岩縫中生存。",
      "source_pdf_page": 1,
      "marker_y": 596.62
    },
    {
      "id": "SCI_G04_S1_114_MID_008|S01|TF|011",
      "text": "岩石長期受到陽光、風和水的影響會漸漸變成土壤。",
      "source_pdf_page": 1,
      "marker_y": 623.74
    },
    {
      "id": "SCI_G04_S1_114_MID_008|S01|TF|012",
      "text": "岩石受到風力或雨水的作用，會先碎裂成小礫石，最後變成土壤。",
      "source_pdf_page": 1,
      "marker_y": 669.25
    },
    {
      "id": "SCI_G04_S1_114_MID_008|S01|TF|013",
      "text": "臺灣萍蓬草和睡蓮都是浮葉性水生植物，當水位降低時，它們葉面都仍然會平貼在水面。",
      "source_pdf_page": 1,
      "marker_y": 714.61
    },
    {
      "id": "SCI_G04_S1_114_MID_008|S01|TF|014",
      "text": "用手撥動水族箱裡的水，能觀察到漂浮性水生植物會隨著水流而改變莖、葉的形態。",
      "source_pdf_page": 1,
      "marker_y": 778.21
    }
  ],
